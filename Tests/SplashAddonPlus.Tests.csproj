<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>NU1701;NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="10.0.3" />
    <PackageReference Include="PlayniteSDK" Version="6.12.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The add-on targets .NET Framework 4.8; its logic is tested from .NET 8 against the built DLL, so build it first. -->
    <Reference Include="SplashAddonPlus">
      <HintPath>../bin/Release/SplashAddonPlus.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
